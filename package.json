{
	"name": "openai-compatible-agent",
	"packageManager": "pnpm@10.8.1",
	"engines": {
		"node": "20.19.2"
	},
	"scripts": {
		"preinstall": "node scripts/bootstrap.mjs",
		"prepare": "husky",
		"install": "node scripts/bootstrap.mjs",
		"install:all": "node scripts/bootstrap.mjs",
		"lint": "turbo lint --log-order grouped --output-logs new-only",
		"lint:security": "eslint --no-config-lookup --config eslint.security.config.mjs \"src/**/*.{ts,tsx}\" \"webview-ui/src/**/*.{ts,tsx}\" \"packages/*/src/**/*.ts\"",
		"lint:cycles": "node scripts/check-circular-deps.mjs",
		"ci:local": "bash scripts/ci-local.sh",
		"check-types": "turbo check-types --log-order grouped --output-logs new-only",
		"test": "turbo test --log-order grouped --output-logs new-only",
		"test:coverage": "turbo test:coverage --log-order grouped --output-logs new-only",
		"format": "turbo format --log-order grouped --output-logs new-only",
		"format:check": "prettier --check --cache .",
		"build": "turbo build --log-order grouped --output-logs new-only",
		"bundle": "turbo bundle --log-order grouped --output-logs new-only",
		"bundle:nightly": "turbo bundle:nightly --log-order grouped --output-logs new-only",
		"bundle:internal": "turbo bundle:internal --log-order grouped --output-logs new-only",
		"vsix": "turbo vsix --log-order grouped --output-logs new-only",
		"vsix:nightly": "turbo vsix:nightly --log-order grouped --output-logs new-only",
		"vsix:internal": "turbo vsix:internal --log-order grouped --output-logs new-only",
		"clean": "turbo clean --log-order grouped --output-logs new-only && rimraf dist out bin .vite-port .turbo",
		"install:vsix": "pnpm install --frozen-lockfile && pnpm clean && pnpm vsix && node scripts/install-vsix.js",
		"install:vsix:nightly": "pnpm install --frozen-lockfile && pnpm clean && pnpm vsix:nightly && node scripts/install-vsix.js --nightly",
		"install:vsix:internal": "pnpm install --frozen-lockfile && pnpm clean && pnpm vsix:internal && node scripts/install-vsix.js --internal",
		"code-server:install": "node scripts/code-server.js",
		"changeset:version": "cp CHANGELOG.md src/CHANGELOG.md && changeset version && cp -vf src/CHANGELOG.md .",
		"knip": "knip --include files",
		"npm:publish:types": "pnpm --filter @openai-agent/types npm:publish",
		"sbom": "node scripts/generate-sbom.js"
	},
	"devDependencies": {
		"@changesets/cli": "^2.27.10",
		"@dotenvx/dotenvx": "^1.34.0",
		"@openai-agent/config-typescript": "workspace:^",
		"@types/glob": "^9.0.0",
		"@types/node": "^24.1.0",
		"@typescript-eslint/parser": "^8.65.0",
		"@vscode/vsce": "3.9.2",
		"esbuild": "^0.25.0",
		"eslint": "^9.27.0",
		"eslint-plugin-security": "^4.0.1",
		"glob": "^11.1.0",
		"husky": "^9.1.7",
		"knip": "^5.44.4",
		"lint-staged": "^16.0.0",
		"madge": "^8.0.0",
		"mkdirp": "^3.0.1",
		"only-allow": "^1.2.1",
		"ovsx": "0.10.4",
		"prettier": "^3.4.2",
		"rimraf": "^6.0.1",
		"ts-morph": "^28.0.0",
		"tsx": "^4.19.3",
		"turbo": "^2.5.6",
		"typescript": "5.8.3"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,css,md}": [
			"prettier --write"
		]
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@vscode/ripgrep",
			"esbuild",
			"@vscode/vsce-sign"
		],
		"overrides": {
			"tar-fs": ">=3.1.1",
			"esbuild": ">=0.25.0",
			"undici": ">=6.27.0 <7",
			"brace-expansion": ">=5.0.9",
			"@isaacs/brace-expansion": ">=5.0.9",
			"form-data": ">=4.0.6",
			"@xmldom/xmldom": ">=0.8.13",
			"underscore": ">=1.13.8",
			"minimatch": ">=10.2.3",
			"picomatch": ">=4.0.4",
			"fast-uri": ">=4.1.2",
			"path-to-regexp": ">=8.4.0",
			"js-cookie": ">=3.0.7",
			"ws": ">=8.21.0",
			"postcss": ">=8.5.23",
			"rollup": ">=4.59.0",
			"vite": ">=6.4.3",
			"qs": ">=6.15.2",
			"yaml": ">=2.8.3",
			"mammoth": ">=1.11.0",
			"mdast-util-to-hast": ">=13.2.1",
			"i18next-http-backend": ">=3.0.5",
			"ip-address": ">=10.1.1",
			"uuid": ">=11.1.1",
			"@hono/node-server": ">=2.0.5",
			"diff": ">=5.2.2",
			"jws": ">=3.2.3",
			"serialize-javascript": ">=7.0.5",
			"flatted": ">=3.4.2",
			"lodash": ">=4.17.21",
			"tmp": ">=0.2.6",
			"linkify-it": ">=5.0.2 <6",
			"markdown-it": ">=14.2.0",
			"smol-toml": ">=1.6.1",
			"follow-redirects": ">=1.16.0",
			"turbo": ">=2.9.14",
			"@eslint/plugin-kit": ">=0.3.4",
			"@babel/core": ">=7.29.6",
			"bluebird": ">=3.7.2",
			"glob": ">=11.1.0",
			"@types/react": "^18.3.23",
			"@types/react-dom": "^18.3.5",
			"zod": "3.25.76",
			"axios": ">=1.18.0",
			"shell-quote": ">=1.9.0",
			"basic-ftp": ">=5.3.1",
			"tar": ">=7.5.19",
			"hono": ">=4.12.34",
			"nanoid": ">=3.3.18"
		}
	}
}
