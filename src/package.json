{
	"name": "openai-agent",
	"displayName": "%extension.displayName%",
	"description": "%extension.description%",
	"publisher": "internal",
	"version": "0.3.0",
	"galleryBanner": {
		"color": "#617A91",
		"theme": "dark"
	},
	"engines": {
		"vscode": "^1.106.0",
		"node": "20.19.2"
	},
	"author": {
		"name": "Example Org"
	},
	"categories": [
		"AI",
		"Chat",
		"Programming Languages",
		"Education",
		"Snippets",
		"Testing"
	],
	"keywords": [
		"cline",
		"claude",
		"dev",
		"mcp",
		"openrouter",
		"coding",
		"agent",
		"autonomous",
		"chatgpt",
		"sonnet",
		"ai",
		"llama",
		"vllm",
		"ollama",
		"azure openai"
	],
	"activationEvents": [
		"onLanguage",
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"viewsContainers": {
			"secondarySidebar": [
				{
					"id": "openai-agent-ActivityBar",
					"title": "%views.activitybar.title%",
					"icon": "assets/icons/icon-internal.svg"
				}
			]
		},
		"views": {
			"openai-agent-ActivityBar": [
				{
					"type": "webview",
					"id": "openai-agent.SidebarProvider",
					"name": "%views.sidebar.name%"
				}
			]
		},
		"commands": [
			{
				"command": "openai-agent.plusButtonClicked",
				"title": "%command.newTask.title%",
				"icon": "$(edit)"
			},
			{
				"command": "openai-agent.historyButtonClicked",
				"title": "%command.history.title%",
				"icon": "$(history)"
			},
			{
				"command": "openai-agent.popoutButtonClicked",
				"title": "%command.openInEditor.title%",
				"icon": "$(link-external)"
			},
			{
				"command": "openai-agent.settingsButtonClicked",
				"title": "%command.settings.title%",
				"icon": "$(settings-gear)"
			},
			{
				"command": "openai-agent.openInNewTab",
				"title": "%command.openInNewTab.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "openai-agent.explainCode",
				"title": "%command.explainCode.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "openai-agent.fixCode",
				"title": "%command.fixCode.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "openai-agent.improveCode",
				"title": "%command.improveCode.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "openai-agent.addToContext",
				"title": "%command.addToContext.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "openai-agent.newTask",
				"title": "%command.newTask.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "openai-agent.terminalAddToContext",
				"title": "%command.terminal.addToContext.title%",
				"category": "Terminal"
			},
			{
				"command": "openai-agent.terminalFixCommand",
				"title": "%command.terminal.fixCommand.title%",
				"category": "Terminal"
			},
			{
				"command": "openai-agent.terminalExplainCommand",
				"title": "%command.terminal.explainCommand.title%",
				"category": "Terminal"
			},
			{
				"command": "openai-agent.setCustomStoragePath",
				"title": "%command.setCustomStoragePath.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "openai-agent.importSettings",
				"title": "%command.importSettings.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "openai-agent.focusInput",
				"title": "%command.focusInput.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "openai-agent.acceptInput",
				"title": "%command.acceptInput.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "openai-agent.toggleAutoApprove",
				"title": "%command.toggleAutoApprove.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "openai-agent.cycleAutonomyMode",
				"title": "%command.cycleAutonomyMode.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "openai-agent.setAutonomyModeManual",
				"title": "%command.setAutonomyModeManual.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "openai-agent.setAutonomyModeAutoEdit",
				"title": "%command.setAutonomyModeAutoEdit.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "openai-agent.setAutonomyModeAuto",
				"title": "%command.setAutonomyModeAuto.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "openai-agent.setAutonomyModePlan",
				"title": "%command.setAutonomyModePlan.title%",
				"category": "%configuration.title%"
			}
		],
		"menus": {
			"editor/context": [
				{
					"submenu": "openai-agent.contextMenu",
					"group": "1"
				}
			],
			"openai-agent.contextMenu": [
				{
					"command": "openai-agent.addToContext",
					"group": "1_actions@1"
				},
				{
					"command": "openai-agent.explainCode",
					"group": "1_actions@2"
				},
				{
					"command": "openai-agent.improveCode",
					"group": "1_actions@3"
				}
			],
			"terminal/context": [
				{
					"submenu": "openai-agent.terminalMenu",
					"group": "2"
				}
			],
			"openai-agent.terminalMenu": [
				{
					"command": "openai-agent.terminalAddToContext",
					"group": "1_actions@1"
				},
				{
					"command": "openai-agent.terminalFixCommand",
					"group": "1_actions@2"
				},
				{
					"command": "openai-agent.terminalExplainCommand",
					"group": "1_actions@3"
				}
			],
			"view/title": [
				{
					"command": "openai-agent.plusButtonClicked",
					"group": "navigation@1",
					"when": "view == openai-agent.SidebarProvider"
				},
				{
					"command": "openai-agent.settingsButtonClicked",
					"group": "navigation@2",
					"when": "view == openai-agent.SidebarProvider"
				},
				{
					"command": "openai-agent.historyButtonClicked",
					"group": "overflow@1",
					"when": "view == openai-agent.SidebarProvider"
				},
				{
					"command": "openai-agent.popoutButtonClicked",
					"group": "overflow@2",
					"when": "view == openai-agent.SidebarProvider"
				}
			],
			"editor/title": [
				{
					"command": "openai-agent.plusButtonClicked",
					"group": "navigation@1",
					"when": "activeWebviewPanelId == openai-agent.TabPanelProvider"
				},
				{
					"command": "openai-agent.settingsButtonClicked",
					"group": "navigation@2",
					"when": "activeWebviewPanelId == openai-agent.TabPanelProvider"
				},
				{
					"command": "openai-agent.historyButtonClicked",
					"group": "overflow@1",
					"when": "activeWebviewPanelId == openai-agent.TabPanelProvider"
				},
				{
					"command": "openai-agent.popoutButtonClicked",
					"group": "overflow@2",
					"when": "activeWebviewPanelId == openai-agent.TabPanelProvider"
				}
			]
		},
		"keybindings": [
			{
				"command": "openai-agent.addToContext",
				"key": "cmd+k cmd+a",
				"mac": "cmd+k cmd+a",
				"win": "ctrl+k ctrl+a",
				"linux": "ctrl+k ctrl+a",
				"when": "editorTextFocus && editorHasSelection"
			},
			{
				"command": "openai-agent.toggleAutoApprove",
				"key": "cmd+alt+a",
				"mac": "cmd+alt+a",
				"win": "ctrl+alt+a",
				"linux": "ctrl+alt+a"
			},
			{
				"command": "openai-agent.cycleAutonomyMode",
				"key": "ctrl+shift+a",
				"mac": "cmd+shift+a",
				"win": "ctrl+shift+a",
				"linux": "ctrl+shift+a"
			}
		],
		"submenus": [
			{
				"id": "openai-agent.contextMenu",
				"label": "%views.contextMenu.label%"
			},
			{
				"id": "openai-agent.terminalMenu",
				"label": "%views.terminalMenu.label%"
			}
		],
		"configuration": {
			"title": "%configuration.title%",
			"properties": {
				"openai-agent.allowedCommands": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"git log",
						"git diff",
						"git show"
					],
					"description": "%commands.allowedCommands.description%"
				},
				"openai-agent.deniedCommands": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"rm -rf",
						"rm -fr",
						"sudo",
						"dd",
						"mkfs",
						"shred",
						":(){",
						"chmod -R 777",
						"chown -R",
						"git push --force",
						"git push -f",
						"git reset --hard",
						"git clean -fd",
						"curl",
						"wget",
						"npm publish",
						"pnpm publish",
						"yarn publish"
					],
					"description": "%commands.deniedCommands.description%"
				},
				"openai-agent.commandExecutionTimeout": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"maximum": 600,
					"description": "%commands.commandExecutionTimeout.description%"
				},
				"openai-agent.commandTimeoutAllowlist": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "%commands.commandTimeoutAllowlist.description%"
				},
				"openai-agent.preventCompletionWithOpenTodos": {
					"type": "boolean",
					"default": false,
					"description": "%commands.preventCompletionWithOpenTodos.description%"
				},
				"openai-agent.customStoragePath": {
					"type": "string",
					"default": "",
					"description": "%settings.customStoragePath.description%"
				},
				"openai-agent.enableCodeActions": {
					"type": "boolean",
					"default": true,
					"description": "%settings.enableCodeActions.description%"
				},
				"openai-agent.autoImportSettingsPath": {
					"type": "string",
					"default": "",
					"description": "%settings.autoImportSettingsPath.description%"
				},
				"openai-agent.maximumIndexedFilesForFileSearch": {
					"type": "number",
					"default": 10000,
					"minimum": 5000,
					"maximum": 500000,
					"description": "%settings.maximumIndexedFilesForFileSearch.description%"
				},
				"openai-agent.useAgentRules": {
					"type": "boolean",
					"default": true,
					"description": "%settings.useAgentRules.description%"
				},
				"openai-agent.apiRequestTimeout": {
					"type": "number",
					"default": 600,
					"minimum": 0,
					"maximum": 3600,
					"description": "%settings.apiRequestTimeout.description%"
				},
				"openai-agent.newTaskRequireTodos": {
					"type": "boolean",
					"default": false,
					"description": "%settings.newTaskRequireTodos.description%"
				},
				"openai-agent.codeIndex.embeddingBatchSize": {
					"type": "number",
					"default": 60,
					"minimum": 1,
					"maximum": 200,
					"description": "%settings.codeIndex.embeddingBatchSize.description%"
				},
				"openai-agent.debug": {
					"type": "boolean",
					"default": false,
					"description": "%settings.debug.description%"
				},
				"openai-agent.debugProxy.enabled": {
					"type": "boolean",
					"default": false,
					"description": "%settings.debugProxy.enabled.description%",
					"markdownDescription": "%settings.debugProxy.enabled.description%"
				},
				"openai-agent.debugProxy.serverUrl": {
					"type": "string",
					"default": "http://127.0.0.1:8888",
					"description": "%settings.debugProxy.serverUrl.description%",
					"markdownDescription": "%settings.debugProxy.serverUrl.description%"
				},
				"openai-agent.debugProxy.tlsInsecure": {
					"type": "boolean",
					"default": false,
					"description": "%settings.debugProxy.tlsInsecure.description%",
					"markdownDescription": "%settings.debugProxy.tlsInsecure.description%"
				}
			}
		}
	},
	"scripts": {
		"lint": "eslint . --ext=ts --max-warnings=0",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage.enabled",
		"format": "prettier --write .",
		"bundle": "node esbuild.mjs",
		"vscode:prepublish": "pnpm bundle --production",
		"vsix": "mkdirp ../bin && vsce package --no-dependencies --out ../bin",
		"publish:marketplace": "vsce publish --no-dependencies && ovsx publish --no-dependencies",
		"watch:bundle": "pnpm bundle --watch",
		"watch:tsc": "cd .. && tsc --noEmit --watch --project src/tsconfig.json",
		"clean": "rimraf README.md LICENSE dist logs mock .turbo"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.26.0",
		"@openai-agent/core": "workspace:^",
		"@openai-agent/ipc": "workspace:^",
		"@openai-agent/types": "workspace:^",
		"@qdrant/js-client-rest": "^1.14.0",
		"@vscode/codicons": "^0.0.36",
		"async-mutex": "^0.5.0",
		"axios": "^1.12.0",
		"cheerio": "^1.0.0",
		"chokidar": "^4.0.1",
		"clone-deep": "^4.0.1",
		"default-shell": "^2.2.0",
		"delay": "^6.0.0",
		"diff": "^5.2.0",
		"diff-match-patch": "^1.0.5",
		"exceljs": "^4.4.0",
		"fast-deep-equal": "^3.1.3",
		"fastest-levenshtein": "^1.0.16",
		"fzf": "^0.5.2",
		"get-folder-size": "^5.0.0",
		"global-agent": "^3.0.0",
		"gray-matter": "^4.0.3",
		"i18next": "^25.0.0",
		"ignore": "^7.0.3",
		"isbinaryfile": "^5.0.2",
		"json-stream-stringify": "^3.1.6",
		"jwt-decode": "^4.0.0",
		"lodash.debounce": "^4.0.8",
		"mammoth": "^1.9.1",
		"monaco-vscode-textmate-theme-converter": "^0.1.7",
		"node-cache": "^5.1.2",
		"node-ipc": "^12.0.0",
		"openai": "^5.12.2",
		"os-name": "^6.0.0",
		"p-limit": "^6.2.0",
		"p-wait-for": "^5.0.2",
		"partial-json": "^0.1.7",
		"pdf-parse": "^1.1.1",
		"pkce-challenge": "^5.0.0",
		"pretty-bytes": "^7.0.0",
		"proper-lockfile": "^4.1.2",
		"ps-tree": "^1.2.0",
		"reconnecting-eventsource": "^1.6.4",
		"safe-stable-stringify": "^2.5.0",
		"sanitize-filename": "^1.6.3",
		"serialize-error": "^12.0.0",
		"shell-quote": "^1.8.2",
		"simple-git": "^3.32.3",
		"socks": "^2.8.4",
		"stream-json": "^1.8.0",
		"string-similarity": "^4.0.4",
		"strip-ansi": "^7.1.0",
		"strip-bom": "^5.0.0",
		"tiktoken": "^1.0.21",
		"tmp": "^0.2.6",
		"tree-sitter-wasms": "^0.1.12",
		"turndown": "^7.2.0",
		"undici": "^6.27.0",
		"uuid": "^11.1.0",
		"vscode-material-icons": "^0.1.1",
		"web-tree-sitter": "^0.25.6",
		"workerpool": "^9.2.0",
		"yaml": "^2.8.0",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@openai-agent/build": "workspace:^",
		"@openai-agent/config-eslint": "workspace:^",
		"@openai-agent/config-typescript": "workspace:^",
		"@types/clone-deep": "^4.0.4",
		"@types/debug": "^4.1.12",
		"@types/diff": "^5.2.1",
		"@types/diff-match-patch": "^1.0.36",
		"@types/glob": "^8.1.0",
		"@types/lodash.debounce": "^4.0.9",
		"@types/mocha": "^10.0.10",
		"@types/node": "20.x",
		"@types/node-cache": "^4.1.3",
		"@types/node-ipc": "^9.2.3",
		"@types/proper-lockfile": "^4.1.4",
		"@types/ps-tree": "^1.1.6",
		"@types/semver-compare": "^1.0.3",
		"@types/shell-quote": "^1.7.5",
		"@types/stream-json": "^1.7.8",
		"@types/string-similarity": "^4.0.2",
		"@types/tmp": "^0.2.6",
		"@types/turndown": "^5.0.5",
		"@types/vscode": "^1.84.0",
		"@vitest/coverage-v8": "3.2.7",
		"@vscode/test-electron": "^2.5.2",
		"@vscode/vsce": "3.9.2",
		"execa": "^9.5.2",
		"glob": "^11.1.0",
		"mkdirp": "^3.0.1",
		"nock": "^14.0.4",
		"npm-run-all2": "^8.0.1",
		"ovsx": "0.10.4",
		"rimraf": "^6.0.1",
		"tsup": "^8.4.0",
		"tsx": "^4.19.3",
		"vitest": "^3.2.3",
		"zod-to-ts": "^1.2.0"
	}
}
