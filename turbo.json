{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"lint": {},
		// cache:false は必須。webview は tsconfig で ../src/shared も型検査するが
		// openai-agent への依存辺が無く、turbo の inputs はパッケージ外を指せない。
		// キャッシュを効かせると型エラーを取り逃がす（pre-push 唯一の型ゲート）。
		"check-types": {
			"dependsOn": ["^check-types"],
			"cache": false
		},
		"bundle": {
			"outputs": ["dist/**"],
			"dependsOn": ["@openai-agent/types#build"]
		},
		"test": {
			"dependsOn": ["@openai-agent/types#build", "openai-agent#bundle"]
		},
		"format": {},
		"clean": {
			"cache": false
		},
		"bundle:internal": {
			"cache": false
		},
		"vsix:internal": {
			"cache": false
		},
		"build": {
			"outputs": ["dist/**"],
			"inputs": ["src/**", "package.json", "tsconfig.json", "tsup.config.ts", "vite.config.ts"]
		},
		"watch:tsc": {
			"cache": false
		},
		"test:coverage": {
			"dependsOn": ["@openai-agent/types#build", "openai-agent#bundle"]
		}
	}
}
